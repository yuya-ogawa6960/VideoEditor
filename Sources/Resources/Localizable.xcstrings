    "話が長い所は要点だけ残してカットする": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut long talking down to the key points"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar las partes habladas largas a los puntos clave"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortar as falas longas para os pontos principais"
          }
        }
      }
    },
    "話している区間を文の切れ目で拾って 3 分のダイジェストに。BGM は会話中に下げる。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks talking sections at sentence breaks into a 3-minute digest. Music ducks during speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma las secciones habladas en los cortes de frase para un resumen de 3 minutos. La música baja durante el habla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega os trechos de fala nas pausas de frase para um resumo de 3 minutos. A música abaixa durante a fala."
          }
        }
      }
    },
