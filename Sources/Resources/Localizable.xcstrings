          }
        }
      }
    },
    "クリップの明るさ・色味はそろっています。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness and color are consistent across clips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
