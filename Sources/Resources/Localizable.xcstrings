        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo para definir tú mismo la relación de aspecto, la resolución, la calidad y el códec."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra para definir você mesmo a proporção, a resolução, a qualidade e o codec."
          }
        }
      }
    },
