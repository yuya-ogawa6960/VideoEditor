          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi curta demais e não foi adicionada."
          }
        }
      }
    },
    "録音したナレーションは再生位置からタイムラインに追加されます。追加後は「音量」や「音量そろえ」で調整できます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded voice-over is added to the timeline at the playhead. Afterwards you can adjust it with “Volume” or “Match loudness”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz en off grabada se agrega a la línea de tiempo en la posición de reproducción. Después puedes ajustarla con “Volumen” o “Igualar volumen”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A narração gravada é adicionada à linha do tempo na posição de reprodução. Depois, ajuste com “Volume” ou “Igualar volume”."
          }
        }
      }
    },
