            "value": "Could not read the frame. Move the playhead and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el fotograma. Mueve la posición de reproducción e inténtalo de nuevo."
          }
        },
        "pt-BR": {
