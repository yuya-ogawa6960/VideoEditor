            "state": "translated",
            "value": "Brilho e cor estão uniformes entre os clipes."
          }
        }
      }
    },
    "クリップの端に近すぎます。端から0.2秒以上離してください": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too close to the clip edge. Keep at least 0.2 s from the edge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado cerca del borde del clip. Deja al menos 0.2 s desde el borde"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perto demais da borda do clipe. Deixe pelo menos 0,2 s da borda"
