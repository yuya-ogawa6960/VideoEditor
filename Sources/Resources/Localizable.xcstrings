    " 空けてください。画質を下げる(「SNS」を選ぶなど)と小さくなります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " free. Lowering the quality (e.g. choosing “Social”) makes it smaller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " libres. Bajar la calidad (p. ej. elegir “Redes sociales”) lo hace más pequeño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " livres. Reduzir a qualidade (ex.: escolher “Redes sociais”) deixa menor."
          }
        }
      }
    },
