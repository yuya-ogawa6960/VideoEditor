          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus puntos y tu historial de uso se eliminan del servidor y no se pueden recuperar. Los proyectos y videos permanecen en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus pontos e histórico de uso são excluídos do servidor e não podem ser recuperados. Projetos e vídeos ficam neste iPhone."
          }
        }
      }
    },
