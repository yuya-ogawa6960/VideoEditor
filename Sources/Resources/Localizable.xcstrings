    "録音": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "record"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "grabar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "gravar"
          }
        }
      }
    },
    "録音が中断されたため、ここまでを追加しました。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted, so what was recorded so far has been added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se interrumpió, así que se añadió lo grabado hasta ese momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida, então o que foi gravado até ali foi adicionado."
          }
        }
      }
    },
    "録音が中断されました。短すぎたため追加しませんでした。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted. It was too short, so it wasn't added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se interrumpió. Era demasiado corta, así que no se añadió."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida. Era curta demais, então não foi adicionada."
          }
        }
      }
    },
    "録音が短すぎたため追加しませんでした。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was too short and was not added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación fue demasiado corta y no se agregó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi curta demais e não foi adicionada."
          }
        }
      }
    },
    "録音したナレーションは再生位置からタイムラインに追加されます。追加後は「音量」や「音量そろえ」で調整できます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded voice-over is added to the timeline at the playhead. Afterwards you can adjust it with “Volume” or “Match loudness”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz en off grabada se agrega a la línea de tiempo en la posición de reproducción. Después puedes ajustarla con “Volumen” o “Igualar volumen”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A narração gravada é adicionada à linha do tempo na posição de reprodução. Depois, ajuste com “Volume” ou “Igualar volume”."
          }
        }
      }
    },
    "録音しながら再生する": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play while recording"
