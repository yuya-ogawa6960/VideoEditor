        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha este app aberto até a exportação terminar.\\nEla para cerca de 30 s depois de ir para a tela inicial.\\nA tela não será bloqueada automaticamente."
          }
        }
      }
    },
