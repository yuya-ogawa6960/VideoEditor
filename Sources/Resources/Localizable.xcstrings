            "state": "translated",
            "value": "Move todas as legendas 0,1 s para trás ou para a frente"
          }
        }
      }
    },
    "±0.1 秒ずつ全字幕を前後に動かします": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves all captions back or forward in 0.1 s steps"
          }
        },
