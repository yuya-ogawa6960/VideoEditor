    "ビートに合わせる": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beat Sync"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar al ritmo"
          }
        },
        "pt-BR": {
