        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "※ Como los clips vecinos son cortos, el máximo real es %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "※ Como os clipes vizinhos são curtos, o máximo real é %@"
          }
        }
      }
    },
