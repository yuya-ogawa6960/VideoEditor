            "value": "\n\nDetalhes: "
          }
        }
      }
    },
    "\n%lld 件中 %lld 件が完了。「取り込む」で残りを待ってから取り込みます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\nOf %lld pieces, %lld are done. “Import” waits for the rest, then imports them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\\nDe %lld partes, %lld están listas. “Importar” espera el resto y luego las importa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\\nDe %lld partes, %lld estão concluídas. “Importar” aguarda o restante e depois importa."
          }
        }
      }
    },
