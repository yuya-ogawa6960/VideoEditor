            "value": "Se aplicó mosaico a %lld rostros"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaico aplicado a %lld rostos"
          }
        }
      }
    },
    "%lld 件": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld itens"
          }
        }
      }
    },
    "%lld 件のナレーションを追加しました。「音量」「音声効果」で調整できます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %lld voice-overs. Adjust them with “Volume” and “Audio Effects”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agregaron %lld voces en off. Ajústalas con “Volumen” y “Efectos de audio”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld narrações adicionadas. Ajuste em “Volume” e “Efeitos de áudio”."
          }
        }
      }
    },
    "%lld 件の字幕に、文字数に応じた単語タイミングを付けました。カラオケ風などのテンプレートで単語ごとに色が変わります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added word timing based on character counts to %lld captions. Templates such as karaoke change color word by word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agregó a %lld subtítulos un tiempo por palabra según el número de caracteres. Las plantillas como karaoke cambian de color palabra por palabra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo por palavra com base no número de caracteres adicionado a %lld legendas. Modelos como karaokê mudam de cor palavra por palavra."
          }
        }
      }
    },
    "%lld 件の字幕を": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld captions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld subtítulos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld legendas"
          }
        }
      }
    },
    "%lld 件の字幕を翻訳しました。「スタイル」の「表示」を「訳文」か「両方」にすると映像に出ます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translated %lld captions. Set “Display” in “Style” to “Translation” or “Both” to show them in the video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tradujeron %lld subtítulos. Pon “Mostrar” en “Estilo” en “Traducción” o “Ambos” para verlos en el video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld legendas traduzidas. Defina “Exibição” em “Estilo” como “Tradução” ou “Ambos” para mostrar no vídeo."
          }
        }
      }
    },
    "%lld 件の字幕を追加しました。「自動字幕」でタイミングや文を直せます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %lld captions. Fix timing and wording in “Auto Captions”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agregaron %lld subtítulos. Corrige tiempos y redacción en “Subtítulos automáticos”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld legendas adicionadas. Corrija tempo e texto em “Legendas automáticas”."
          }
        }
      }
    },
    "%lld 件の音量をそろえました": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leveled %lld items"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nivelaron %lld elementos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld itens nivelados"
          }
        }
      }
    },
    "%lld 個のテキストが、文字数に対して表示が短く読み切れない可能性があります(目安: 0.8 秒 + 1 文字 0.12 秒)。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld texts may be shown too briefly for their length (guide: 0.8 s + 0.12 s per character)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld textos podrían mostrarse demasiado poco para su longitud (guía: 0.8 s + 0.12 s por carácter)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld textos podem aparecer por pouco tempo para o seu tamanho (referência: 0,8 s + 0,12 s por caractere)."
          }
        }
      }
    },
    "%lld 個のテキストが画面の端にあり、TikTok・リール・ショートのボタンや説明文に隠れる可能性があります。少し内側に寄せましょう。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld texts are at the edge of the screen and may be hidden by TikTok, Reels or Shorts buttons and captions. Move them inward a little."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld textos están en el borde de la pantalla y podrían quedar tapados por los botones y descripciones de TikTok, Reels o Shorts. Muévelos un poco hacia adentro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld textos estão na borda da tela e podem ser cobertos pelos botões e descrições do TikTok, Reels ou Shorts. Mova-os um pouco para dentro."
          }
        }
      }
    },
