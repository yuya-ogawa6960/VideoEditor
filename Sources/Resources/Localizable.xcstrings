            "value": "Which features are used is sent with a random per-device ID. No videos, text or names are sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía qué funciones se usan con un ID aleatorio por dispositivo. No se envían videos, textos ni nombres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais recursos são usados é enviado com um ID aleatório por aparelho. Vídeos, textos e nomes não são enviados."
