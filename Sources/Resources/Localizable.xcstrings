          "stringUnit": {
            "state": "translated",
            "value": "Your points and usage history are deleted from the server and cannot be restored. Projects and videos stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus puntos y tu historial de uso se eliminan del servidor y no se pueden recuperar. Los proyectos y videos permanecen en este iPhone."
          }
        },
        "pt-BR": {
