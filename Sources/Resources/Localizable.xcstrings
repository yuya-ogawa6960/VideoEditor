        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo donde tengas conexión. Si sigue pasando, revisa “Ajustes de IA”.\n\nDetalles: "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente de novo onde houver conexão. Se continuar, confira os “Ajustes de IA”.\n\nDetalhes: "
          }
        }
      }
    },
