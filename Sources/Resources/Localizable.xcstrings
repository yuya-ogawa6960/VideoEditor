          }
        }
      }
    },
    "選択中のクリップがあればそのクリップだけ、なければ全クリップに入れます。「元に戻す」で戻せます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the selected clip, or to all clips if none is selected. Undo to go back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al clip seleccionado, o a todos si no hay ninguno seleccionado. Deshacer para volver."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica ao clipe selecionado, ou a todos se nenhum estiver selecionado. Desfazer para voltar."
          }
        }
      }
    },
    "配置": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout"
          }
        },
        "es": {
