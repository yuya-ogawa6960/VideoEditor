            "value": "No hay fotogramas para escribir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum quadro para gravar"
          }
        }
      }
    },
    "最も軽く速い。精度は低め(短い確認用)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightest and fastest. Lower accuracy (for quick checks)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El más ligero y rápido. Menor precisión (para revisiones rápidas)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mais leve e rápido. Menor precisão (para conferências rápidas)"
          }
        }
      }
    },
    "最初と最後を黒から": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade from/to black"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundido desde/hacia negro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade do/para o preto"
          }
        }
      }
    },
    "最初にタイトルを入れる": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a title at the start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner un título al inicio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar um título no início"
          }
        }
      }
    },
    "最初の 1 つを見る": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View the first one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver el primero"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver o primeiro"
          }
        }
      }
    },
    "最初の 1 秒が無音で動きもありません。頭を少し切ると、テンポよく始まります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first second is silent and still. Trimming the head a little gives a snappier start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer segundo está en silencio y sin movimiento. Recortar un poco el inicio da un comienzo más ágil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro segundo está em silêncio e parado. Cortar um pouco o início dá um começo mais ágil."
          }
        }
      }
    },
    "最初の 3 秒が静かです。結論や一番いい場面を先に見せる、テキストで「何の動画か」を出すと離脱が減ります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first 3 seconds are quiet. Show the conclusion or best scene first, or add text saying what the video is about, to reduce drop-off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros 3 segundos son tranquilos. Muestra primero la conclusión o la mejor escena, o agrega texto que diga de qué trata el video, para reducir el abandono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os primeiros 3 segundos são quietos. Mostre primeiro a conclusão ou a melhor cena, ou adicione um texto dizendo do que é o vídeo, para reduzir o abandono."
          }
        }
      }
    },
    "最初の 3 秒に話・動き・テキストのどれかがあり、引きつけられます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first 3 seconds have speech, motion or text and grab attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros 3 segundos tienen voz, movimiento o texto y captan la atención."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os primeiros 3 segundos têm fala, movimento ou texto e prendem a atenção."
          }
        }
      }
    },
    "最後の 2 秒でフェードアウト": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade out over the last 2 s"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar gradualmente en los últimos 2 s"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminuir aos poucos nos últimos 2 s"
          }
        }
      }
    },
    "最後の 5 秒が静かです。余韻が長いと最後まで見られにくいので、短くするか、次の動画やチャンネル登録への一言を入れましょう。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last 5 seconds are quiet. A long tail makes people leave early, so shorten it or add a line about the next video or subscribing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los últimos 5 segundos son tranquilos. Un final largo hace que la gente se vaya antes; acórtalo o agrega una frase sobre el siguiente video o la suscripción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos 5 segundos são quietos. Um final longo faz as pessoas saírem antes; encurte ou adicione uma frase sobre o próximo vídeo ou a inscrição."
          }
        }
      }
    },
    "最後の2秒でだんだん小さくする": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade out over the last 2 seconds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar gradualmente en los últimos 2 segundos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminuir aos poucos nos últimos 2 segundos"
          }
        }
      }
    },
    "最後のクリップには次のクリップがないため、トランジションは使えません。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last clip has no next clip, so a transition cannot be used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último clip no tiene un clip siguiente, así que no se puede usar una transición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último clipe não tem um próximo clipe, então não dá para usar transição."
          }
        }
      }
    },
