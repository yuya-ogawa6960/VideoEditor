    "使うポイント": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points Used"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos usados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos usados"
          }
        }
      }
    },
    "使うポイント: クラウドの文字起こし 1 分 = 5、字幕の整え・翻訳・台本 1 回 = 2。端末内の AI(Whisper・Apple Intelligence・中だるみチェックなど)はポイントなしで使えます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points used: cloud transcription 1 min = 5, caption cleanup / translation / script 1 run = 2. On-device AI (Whisper, Apple Intelligence, pacing check, etc.) costs no points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos que se usan: transcripción en la nube 1 min = 5, limpieza de subtítulos / traducción / guion 1 vez = 2. La IA en el dispositivo (Whisper, Apple Intelligence, revisión de ritmo, etc.) no gasta puntos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos usados: transcrição na nuvem 1 min = 5, limpeza de legendas / tradução / roteiro 1 vez = 2. A IA no aparelho (Whisper, Apple Intelligence, verificação de ritmo etc.) não gasta pontos."
          }
        }
      }
    },
