            "state": "translated",
            "value": "Load LUT: loads a color preset file (.cube) such as a film look and applies that color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar LUT: carga un archivo de preajuste de color (.cube), como un look de cine, y aplica ese color."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
