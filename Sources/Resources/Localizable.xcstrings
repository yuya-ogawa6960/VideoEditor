    "%lld 本のクリップで、人物が画面の端に寄っていて縦に切り出すと見切れます。「オートリフレーム」で人物を追いかけて中央に映せます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %lld clips the person is near the edge and gets cut off in the portrait crop. “Auto Reframe” can follow them and keep them centered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %lld clips la persona está cerca del borde y se corta en el recorte vertical. “Reencuadre automático” puede seguirla y mantenerla centrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %lld clipes a pessoa está perto da borda e fica cortada no recorte vertical. “Reenquadramento automático” pode segui-la e mantê-la centralizada."
          }
        }
      }
    },
    "%lld 本のクリップは、そのクリップで選んだ言語で作ります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clips use the language chosen for that clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clips usan el idioma elegido para cada clip."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clipes usam o idioma escolhido para cada clipe."
          }
        }
      }
    },
    "%lld 本のクリップを削除しました": {
      "extractionState": "manual",
