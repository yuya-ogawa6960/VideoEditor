    "録音が短すぎたため追加しませんでした。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was too short and was not added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
