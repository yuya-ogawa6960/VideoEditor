    "%lld 行の台本ができました。内容と時刻を直してから挿入できます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A script of %lld lines is ready. Fix the content and times, then insert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un guion de %lld líneas. Corrige el contenido y los tiempos y luego insértalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um roteiro com %lld linhas está pronto. Corrija o conteúdo e os tempos e depois insira."
