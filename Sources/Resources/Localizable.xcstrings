    "話がゆっくりで、間延びしやすいです": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is slow and tends to drag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El habla es lenta y tiende a alargarse"
          }
        },
        "pt-BR": {
