{
  "sourceLanguage": "ja",
  "strings": {
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集する動画を選ぶために写真ライブラリを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo library is used to choose videos to edit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fototeca se usa para elegir los videos que vas a editar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca de fotos é usada para escolher os vídeos a editar."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出した動画を保存するために写真ライブラリを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo library is used to save exported videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fototeca se usa para guardar los videos exportados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca de fotos é usada para salvar os vídeos exportados."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の音声から字幕を自動作成するために音声認識を使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is used to create captions automatically from the video audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz se usa para crear subtítulos automáticamente a partir del audio del video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala é usado para criar legendas automaticamente a partir do áudio do vídeo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナレーションを録音するためにマイクを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used to record voice-overs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se usa para grabar voces en off."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone é usado para gravar narrações."
          }
        }
      }
    }
  },
  "version": "1.0"
}
