{
  "sourceLanguage": "ja",
  "strings": {
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画や写真を読み込み、写真アプリで消された動画を確かめるために使います。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to load videos and photos, and to check for videos deleted in the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para cargar videos y fotos y comprobar si hay videos eliminados en la app Fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para carregar vídeos e fotos e verificar vídeos apagados no app Fotos."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出した動画を保存するために写真ライブラリを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo library is used to save exported videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fototeca se usa para guardar los videos exportados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca de fotos é usada para salvar os vídeos exportados."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の音声から字幕を自動作成するために音声認識を使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is used to create captions automatically from the video audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz se usa para crear subtítulos automáticamente a partir del audio del video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala é usado para criar legendas automaticamente a partir do áudio do vídeo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナレーションを録音するためにマイクを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used to record narration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se usa para grabar narraciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone é usado para gravar narrações."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を撮ってプロジェクトに入れるためにカメラを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to record videos for your project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para grabar videos para tu proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada para gravar vídeos para o seu projeto."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたに合った広告を表示するために使用します。許可しなくてもアプリはすべて使えます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show ads that suit you. Every feature of the app works even if you don’t allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para mostrarte anuncios adecuados para ti. Todas las funciones de la app funcionan aunque no lo permitas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para mostrar anúncios adequados a você. Todos os recursos do app funcionam mesmo se você não permitir."
          }
        }
      }
    }
  },
  "version": "1.0"
}